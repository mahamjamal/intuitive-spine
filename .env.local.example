# Email Configuration for Booking Form
# Copy this file to .env.local and fill in the values

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=Intuitive Spine <bookings@yourdomain.com>

# Email address to receive booking notifications
RECEIVING_EMAIL=youremail@gmail.com
